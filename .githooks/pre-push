#!/bin/sh
# Runs before every push: build, then the unit tests that need no model (the mock engines). Takes a few minutes.
# Set AGENT_PREPUSH_BUILD_DIR to the build directory (default: build). Skip: git push --no-verify
dir=${AGENT_PREPUSH_BUILD_DIR:-build}
if [ ! -d "$dir" ]; then
    echo "pre-push: no build directory '$dir' (set AGENT_PREPUSH_BUILD_DIR); skipping" >&2
    exit 0
fi
echo "pre-push: building in $dir ..."
cmake --build "$dir" -j 8 >/dev/null || { echo "pre-push: build failed (run: cmake --build $dir)" >&2; exit 1; }
echo "pre-push: running tests ..."
ctest --test-dir "$dir" -C Release -LE 'model|slow' --output-on-failure -j 4 || { echo "pre-push: tests failed" >&2; exit 1; }
