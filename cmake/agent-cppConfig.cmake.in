# agent-cpp CMake package. Imported targets:
#   agent-cpp::agent         libagent (public header <agent-cpp/agent.hpp>, plugin ABI <agent-cpp/engine_abi.h>)
#   agent-cpp::store_sqlite  optional SQLite KV store + sqlite-vec vector store (<agent-cpp/store_sqlite.hpp>)
#   agent-cpp::hub           optional Hugging Face model downloader (<agent-cpp/hub.hpp>), if it was built
#   agent-cpp::engine_abi    header-only plugin ABI (<agent-cpp/engine_abi.h>) for engine plugins
# Functions (agent-cppEngine.cmake): agent_add_engine(), agent_install_engine().
# Variables: agent-cpp_ENGINE_DIR (installed plugins), agent-cpp_ENGINE_HOST (agent-engine-host).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(agent-cpp_SHARED_LIBS @AGENT_PACKAGE_SHARED@)
set(agent-cpp_HAS_HUB @AGENT_PACKAGE_HAS_HUB@)

# Private link dependencies of the static libraries (shared builds resolve them at link time).
if(NOT agent-cpp_SHARED_LIBS)
    find_dependency(Threads)
    if(agent-cpp_HAS_HUB)
        find_dependency(OpenSSL)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/agent-cppTargets.cmake")

# Where engine plugins are installed (<prefix>/lib/agent/engines). It may not exist when no
# engine was built, so it is not checked.
set(agent-cpp_ENGINE_DIR "@PACKAGE_AGENT_INSTALL_ENGINEDIR@")
# The out-of-process engine host (EngineIsolation::Process). libagent looks for it next to the running
# executable; programs installed elsewhere pass this path as Config::engine_host_path (or set
# $AGENT_ENGINE_HOST).
set(agent-cpp_ENGINE_HOST "@PACKAGE_CMAKE_INSTALL_BINDIR@/agent-engine-host${CMAKE_EXECUTABLE_SUFFIX}")

# Components: find_package(agent-cpp REQUIRED COMPONENTS graph mcp rag models llama audiocpp sdcpp trellis onnx)
# The library parts are found when this build of agent.cpp includes them; an engine is found when its plugin is installed.
set(agent-cpp_graph_FOUND @AGENT_WITH_GRAPH@)
set(agent-cpp_mcp_FOUND @AGENT_WITH_MCP@)
set(agent-cpp_rag_FOUND @AGENT_WITH_RAG@)
set(agent-cpp_models_FOUND @AGENT_WITH_MODELS@)
foreach(_engine llama audiocpp sdcpp trellis onnx)
    file(GLOB _plugin "${agent-cpp_ENGINE_DIR}/agent-engine-${_engine}.*")
    if(_plugin)
        set(agent-cpp_${_engine}_FOUND TRUE)
    else()
        set(agent-cpp_${_engine}_FOUND FALSE)
    endif()
endforeach()

# Name what is missing, and how to build it, when a requested component is not part of this install.
set(_agent_missing "")
foreach(_c IN LISTS agent-cpp_FIND_COMPONENTS)
    if(agent-cpp_FIND_REQUIRED_${_c} AND NOT agent-cpp_${_c}_FOUND)
        string(TOUPPER "${_c}" _u)
        if(_c MATCHES "^(graph|mcp|rag|models)$")
            string(APPEND _agent_missing "
  ${_c}: rebuild agent.cpp with -DAGENT_WITH_${_u}=ON")
        else()
            string(APPEND _agent_missing "
  ${_c}: build agent.cpp with -DAGENT_ENGINE_${_u}=ON and install it")
        endif()
    endif()
endforeach()
if(_agent_missing)
    set(agent-cpp_NOT_FOUND_MESSAGE "This agent.cpp install lacks components you asked for:${_agent_missing}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/agent-cppEngine.cmake")

check_required_components(agent-cpp)
