# Imported targets for the shared libraries of an upstream release (llama.cpp, audio.cpp, ...), so an engine plugin can be compiled against
# a release it will run with instead of compiling that project too. The plugin is small; the library is what the installer downloads.
#
#   agent_prebuilt_library(NAME DIR [OUTPUT_NAME name])
#     NAME   the target name; DIR the folder with the release's libraries; OUTPUT_NAME the file stem (default NAME)
#
# Linux and macOS: lib<stem>.so[.N] / lib<stem>.dylib in DIR. Windows: <stem>.dll in DIR, whose import library is made here from the
# DLL's export table (the releases ship the DLLs only; needs dumpbin and lib, which every Visual Studio command prompt has).
function(agent_prebuilt_library NAME DIR)
    cmake_parse_arguments(P "" "OUTPUT_NAME" "" ${ARGN})
    if(NOT P_OUTPUT_NAME)
        set(P_OUTPUT_NAME ${NAME})
    endif()
    add_library(${NAME} SHARED IMPORTED GLOBAL)
    if(WIN32)
        set(_dll "${DIR}/${P_OUTPUT_NAME}.dll")
        if(NOT EXISTS "${_dll}")
            message(FATAL_ERROR "${_dll} is missing: DIR must hold an upstream release of ${P_OUTPUT_NAME}")
        endif()
        set(_gen "${CMAKE_CURRENT_BINARY_DIR}/prebuilt/${NAME}")
        file(MAKE_DIRECTORY "${_gen}")
        find_program(_dumpbin dumpbin REQUIRED)
        find_program(_libexe lib REQUIRED)
        execute_process(COMMAND "${_dumpbin}" /exports "${_dll}" OUTPUT_VARIABLE _exports RESULT_VARIABLE _rc)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "dumpbin could not read ${_dll}")
        endif()
        string(REPLACE "\r" "" _exports "${_exports}")
        string(REPLACE "\n" ";" _lines "${_exports}")
        set(_def "LIBRARY ${P_OUTPUT_NAME}\nEXPORTS\n")
        foreach(_l IN LISTS _lines)
            if(_l MATCHES "^ +[0-9]+ +[0-9A-Fa-f]+ +[0-9A-Fa-f]+ +([^ ]+)")
                string(APPEND _def "    ${CMAKE_MATCH_1}\n")
            endif()
        endforeach()
        file(WRITE "${_gen}/${P_OUTPUT_NAME}.def" "${_def}")
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM64|aarch64|arm64")
            set(_machine ARM64)
        else()
            set(_machine X64)
        endif()
        execute_process(COMMAND "${_libexe}" /nologo "/def:${_gen}/${P_OUTPUT_NAME}.def" "/machine:${_machine}" "/out:${_gen}/${P_OUTPUT_NAME}.lib"
                        RESULT_VARIABLE _rc OUTPUT_QUIET)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "lib could not make an import library for ${_dll}")
        endif()
        set_target_properties(${NAME} PROPERTIES IMPORTED_LOCATION "${_dll}" IMPORTED_IMPLIB "${_gen}/${P_OUTPUT_NAME}.lib")
    else()
        set(_ext so)
        if(APPLE)
            set(_ext dylib)
        endif()
        file(GLOB _found "${DIR}/lib${P_OUTPUT_NAME}.${_ext}" "${DIR}/lib${P_OUTPUT_NAME}.${_ext}.[0-9]*")
        list(SORT _found)
        if(NOT _found)
            message(FATAL_ERROR "lib${P_OUTPUT_NAME}.${_ext} is missing in ${DIR}: DIR must hold an upstream release")
        endif()
        list(GET _found 0 _lib)
        # The soname is what the plugin will ask for at run time: read it from the file when it is a numbered one.
        get_filename_component(_leaf "${_lib}" NAME)
        set_target_properties(${NAME} PROPERTIES IMPORTED_LOCATION "${_lib}")
        file(GLOB _numbered "${DIR}/lib${P_OUTPUT_NAME}.${_ext}.[0-9]")
        if(_numbered)
            list(GET _numbered 0 _num)
            get_filename_component(_soname "${_num}" NAME)
            set_target_properties(${NAME} PROPERTIES IMPORTED_SONAME "${_soname}")
        endif()
    endif()
endfunction()
